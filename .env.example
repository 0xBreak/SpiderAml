# Copy to .env (never commit it). Testnet keys only.

# Contracts deployer / registry owner
PRIVATE_KEY=0x...
# Data-layer key that writes risk records into SpiderRegistry (scripts/deploy.sh grants it the writer role)
WRITER_PRIVATE_KEY=0x...
# Optional: registry owner if not the deployer (e.g. a Safe)
# OWNER=0x...
# Optional: token for SpiderSend; Circle test USDC on Arbitrum Sepolia
# SEND_TOKEN=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# RPC endpoints used by contracts/foundry.toml aliases
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
