# Private channel to the data layer (spideraml-data). Server-side only — never prefix with NEXT_PUBLIC_.
DATA_URL=http://127.0.0.1:8787
DATA_SECRET=
# Render pages with generated demo data (no data layer needed).
# In development it also turns on automatically when DATA_URL is empty.
# DATA_DEMO=1
# Contacts in the footer; leave empty to hide (never point at an address that does not receive mail)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TELEGRAM=
